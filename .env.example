# Supabase (sister creates the project; values come from Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated list of admin email(s) allowed into /admin. Must match the
# email of the login created in Supabase Auth. If unset, nobody is admin.
ADMIN_EMAILS=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional: extra generated/allowed coupons as JSON, e.g. {"SUMMER10":{"percent_off":10,"name":"Summer 10% off"}}
STRIPE_COUPONS_JSON=
LOCAL_COUPONS_JSON=
LEEMAH5_MAX_USES=10

# Public site URL (used in Stripe success/cancel redirects when no Origin header is present)
NEXT_PUBLIC_APP_URL=http://localhost:3000
